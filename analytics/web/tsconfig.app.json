{
  "compilerOptions": {
    "noCheck": true, 
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,     // ← true → false
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting - отключаем всё */
    "noUnusedLocals": false,           // ← true → false
    "noUnusedParameters": false,       // ← true → false
    "erasableSyntaxOnly": false,       // ← true → false
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src"],
  "exclude": ["src/features/lib"]      // ← добавляем исключение
}